# Leave OPENAI_API_KEY empty for clearly labeled offline DEMO mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# agents_sdk (requires pip install openai-agents) OR chat_completions
ZHIYUE_LLM_ADAPTER=agents_sdk
ZHIYUE_DATA_DIR=./data
# Only enable the reset endpoint in a trusted local demo
ZHIYUE_ENABLE_RESET=0
